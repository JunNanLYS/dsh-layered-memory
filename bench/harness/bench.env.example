# DSH-MemBench 模型配置模板
# ─────────────────────────────────────────────────────────────────────────
# 用法：复制一份并按需填写（bench.env 已被 .gitignore 排除，绝不入库）：
#   cp bench/harness/bench.env.example bench/harness/bench.env
#
# 优先级：命令行参数（--provider/--model/--judge-*/--distill-*）> 本文件 > 内置缺省。
# 留空的项按缺省处理；网关三件套（BASE_URL/API_KEY）不配则不注入任何
# 自定义 provider（沿用 dsh 用户 settings.yaml 里已定义的供应商）。
# ─────────────────────────────────────────────────────────────────────────

# ── 被测 Agent 模型（跑场景干活的模型）──
BENCH_PROVIDER=deepseek-official
BENCH_MODEL=deepseek-v4-flash
# 被测模型思考强度（off/low/medium/high/xhigh/max…，词表由适配器持有，OpenAI 系为 none）
# 留空 = 不传，跟随 provider 默认档
BENCH_REASONING_EFFORT=

# ── 判卷模型（对话赛道 llm/abstain-llm 题型的评分；缺省同被测模型，
#    正式跑建议换模型避免自判偏置）──
BENCH_JUDGE_PROVIDER=
BENCH_JUDGE_MODEL=
# 判卷思考强度（留空 = 不传跟随默认；判卷是短判定任务，通常 off/low 即可）
BENCH_JUDGE_REASONING_EFFORT=

# ── 蒸馏模型（A 组记忆插件后台蒸馏用；缺省 deepseek-official/deepseek-v4-flash）──
BENCH_DISTILL_PROVIDER=
BENCH_DISTILL_MODEL=
# 蒸馏思考强度（缺省 off——后台蒸馏任务不需要思考）
BENCH_DISTILL_REASONING_EFFORT=

# ── 自定义 OpenAI 兼容网关（可选）──
# 配置了 BENCH_TEST_BASE_URL 才会注册临时 provider「bench-gw」，并把
# BENCH_MODEL（及共网关的判卷/蒸馏模型）挂到它的模型表；API key 通过
# 环境变量名引用（apiKeyEnv），run.mjs 会把 key 注入本次运行的子进程。
# 配好后 BENCH_PROVIDER 填 bench-gw（或留空自动采用）。
BENCH_TEST_BASE_URL=
BENCH_TEST_API_KEY=
BENCH_TEST_API=openai-responses

# 判卷走另一个网关时才填（缺省与被测共用 bench-gw）；
# 配置了 BENCH_JUDGE_BASE_URL 才会注册临时 provider「bench-judge-gw」。
BENCH_JUDGE_BASE_URL=
BENCH_JUDGE_API_KEY=
BENCH_JUDGE_API=openai-responses
